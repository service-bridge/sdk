{
	"name": "service-bridge",
	"version": "2.0.0-alpha.15",
	"description": "TypeScript SDK for ServiceBridge \u2014 RPC, durable events, workflows, jobs and observability over a single self-hosted gRPC runtime with mTLS.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/service-bridge/sdk.git",
		"directory": "node"
	},
	"homepage": "https://servicebridge.dev",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"keywords": [
		"microservices",
		"rpc",
		"events",
		"workflows",
		"grpc",
		"mtls",
		"observability"
	],
	"engines": {
		"node": "^22.0.0 || ^24.0.0 || ^26.0.0",
		"bun": ">=1.3.13"
	},
	"files": [
		"dist",
		"skill",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "bun run --hot index.ts",
		"start": "bun run index.ts",
		"build": "tsup",
		"prepack": "bun run build",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write . && tsc --noEmit",
		"test": "bun test src/ tests/build tests/http",
		"test:e2e": "bash ../scripts/e2e-parallel.sh",
		"test:all": "bun run test && bun run test:e2e"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./express": {
			"types": "./dist/http/express/index.d.ts",
			"import": "./dist/http/express/index.js"
		},
		"./fastify": {
			"types": "./dist/http/fastify/index.d.ts",
			"import": "./dist/http/fastify/index.js"
		},
		"./hono": {
			"types": "./dist/http/hono/index.d.ts",
			"import": "./dist/http/hono/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@hono/node-server": "^2.1.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/bun": "latest",
		"@types/express": "^5.0.6",
		"@types/pg": "^8.23.1",
		"express": "^5.2.1",
		"fast-check": "^4.10.2",
		"fastify": "^5.12.5",
		"hono": "^4.13.13",
		"pg": "^8.23.1",
		"ts-proto": "^2.13.0",
		"tsup": "^8.5.1"
	},
	"peerDependencies": {
		"express": "^4 || ^5",
		"fastify": "^4 || ^5",
		"hono": "^4",
		"typescript": "^5.9.3"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		},
		"fastify": {
			"optional": true
		},
		"hono": {
			"optional": true
		}
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.16.0",
		"@grpc/grpc-js": "1.14.5",
		"@peculiar/x509": "^2.1.0",
		"fastify-plugin": "^5.1.0",
		"protobufjs": "^8.8.0",
		"reflect-metadata": "^0.2.2",
		"uuidv7": "^1.2.1"
	},
	"overrides": {
		"esbuild": "^0.28.2"
	},
	"optionalDependencies": {
		"better-sqlite3": "^12.11.1"
	}
}
