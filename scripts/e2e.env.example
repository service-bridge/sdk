# Database access used by bootstrap-e2e-keys.sh in Docker mode.
PG_CONTAINER=servicebridge-postgres-1
PG_USER=postgres
PG_DATABASE=service-bridge-v3

# Go E2E database overrides; direct mode uses SB_E2E_PG_DSN instead.
SB_E2E_PG_CONTAINER=servicebridge-postgres-1
SB_E2E_PG_USER=postgres
SB_E2E_PG_DATABASE=service-bridge-v3
SB_E2E_PG_HOST=localhost
SB_E2E_PG_PORT=5433
SB_E2E_PG_PASSWORD=postgres
