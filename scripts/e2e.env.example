# Database access used by bootstrap-e2e-keys.sh in Docker mode.
PG_CONTAINER=servicebridge2-pg
PG_USER=servicebridge
PG_DATABASE=service-bridge

# Go E2E database overrides; direct mode uses SB_E2E_PG_DSN instead.
SB_E2E_PG_CONTAINER=servicebridge2-pg
SB_E2E_PG_USER=servicebridge
SB_E2E_PG_DATABASE=service-bridge
SB_E2E_PG_HOST=localhost
SB_E2E_PG_PORT=5433
# SB_E2E_PG_PASSWORD=
